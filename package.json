{
  "name": "ojisan-in-another-world",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build":    "npm run build --workspaces",
    "dev":      "npm run dev    --workspace=apps/ojisan",
    "test":     "npm run test   --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  }
}
