{
  "name": "ojisan-in-another-world",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "dev": "npm run dev    --workspace=apps/ojisan",
    "test": "npm run test   --workspaces --if-present",
    "typecheck": "npm run typecheck --workspace=apps/ojisan",
    "typecheck:all": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^5.4.0"
  }
}
